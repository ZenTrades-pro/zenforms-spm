{
  "name": "Asset auto-populate tokens",
  "version": 1,
  "howToRun": "For each case: if assetType is present, merge it into asset first (see the handoff, \"Asset type fallback\"). Build the tokens and compare with expected exactly: same keys, same strings. Then resolve every lookup as an AUTO_POPULATE field would and compare with value. Run a case with timeZone set in that time zone; a case without one must pass in any time zone.",
  "dateFormat": "MM/DD/YYYY",
  "cases": [
    {
      "id": "full-asset-los-angeles",
      "description": "Every ASSET field and every custom field type. installedAt/warrantyExpiresAt fall on the previous day in Los Angeles; the custom DATE does not move.",
      "timeZone": "America/Los_Angeles",
      "asset": {
        "id": 301,
        "assetTypeId": 11,
        "name": "SD-01",
        "serialNumber": "SD-7731-A",
        "model": "2WT-B",
        "brand": "System Sensor",
        "position": "Level 1 > Lobby",
        "assetTypeName": "Smoke Detector",
        "installedAt": 1615528800000,
        "warrantyExpiresAt": 1931058000000,
        "customFieldValues": [
          {
            "assetCustomFieldId": 901,
            "name": "manufactureYear",
            "displayName": "Manufacture Year",
            "dataType": "NUMBER",
            "uiType": "INPUT",
            "value": "2019"
          },
          {
            "assetCustomFieldId": 902,
            "name": "batteryType",
            "displayName": "Battery Type",
            "dataType": "TEXT",
            "uiType": "DROPDOWN",
            "value": "Lithium"
          },
          {
            "assetCustomFieldId": 903,
            "name": "lastBatteryChange",
            "displayName": "Last Battery Change",
            "dataType": "DATE",
            "uiType": "INPUT",
            "value": 1748736000000
          },
          {
            "assetCustomFieldId": 904,
            "name": "certifications",
            "displayName": "Certifications",
            "dataType": "ARRAY",
            "uiType": "CHECKBOX",
            "value": "UL 268, FM"
          },
          {
            "assetCustomFieldId": 905,
            "name": "coverageArea",
            "displayName": "Coverage Area",
            "dataType": "NUMBER",
            "uiType": "DERIVED",
            "value": "900"
          },
          {
            "assetCustomFieldId": 906,
            "name": "datasheet",
            "displayName": "Datasheet",
            "dataType": "ATTACHMENT",
            "uiType": "ATTACHMENT",
            "value": [
              "https://files.example/sd.pdf"
            ]
          },
          {
            "assetCustomFieldId": 907,
            "name": "Rated_Flow",
            "displayName": "Rated Flow",
            "dataType": "NUMBER",
            "uiType": "INPUT",
            "value": "122.22"
          }
        ]
      },
      "expected": {
        "ASSET": {
          "name": "SD-01",
          "serialNumber": "SD-7731-A",
          "model": "2WT-B",
          "brand": "System Sensor",
          "position": "Level 1 > Lobby",
          "assetTypeName": "Smoke Detector",
          "installedAt": "03/11/2021",
          "warrantyExpiresAt": "03/11/2031"
        },
        "ASSET_CUSTOM_FIELD": {
          "manufactureyear": "2019",
          "batterytype": "Lithium",
          "lastbatterychange": "06/01/2025",
          "certifications": "UL 268, FM",
          "rated_flow": "122.22"
        }
      },
      "lookups": [
        {
          "entityType": "ASSET",
          "entity": "serialNumber",
          "value": "SD-7731-A"
        },
        {
          "entityType": "ASSET_CUSTOM_FIELD",
          "entity": "rated_flow",
          "value": "122.22"
        },
        {
          "entityType": "ASSET_CUSTOM_FIELD",
