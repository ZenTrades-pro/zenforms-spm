    {
      "id": "custom-date-is-utc",
      "description": "A custom DATE at 23:30 UTC stays on its UTC day even where local time is already the next day.",
      "timeZone": "Asia/Kolkata",
      "asset": {
        "customFieldValues": [
          {
            "name": "lastBatteryChange",
            "dataType": "DATE",
            "uiType": "INPUT",
            "value": 1748820600000
          },
          {
            "name": "nextService",
            "dataType": "DATE",
            "uiType": "INPUT",
            "value": "1767139200000"
          },
          {
            "name": "commissioned",
            "dataType": "DATE",
            "uiType": "INPUT",
            "value": "2024-02-29T00:00:00.000Z"
          }
        ]
      },
      "expected": {
        "ASSET": {},
        "ASSET_CUSTOM_FIELD": {
          "lastbatterychange": "06/01/2025",
          "nextservice": "12/31/2025",
          "commissioned": "02/29/2024"
        }
      }
    },
    {
      "id": "zero-and-empty",
      "description": "A number 0 is a value. Empty strings, nulls and empty arrays give no key, so the field fills blank.",
      "asset": {
        "serialNumber": "",
        "model": null,
        "warrantyExpiresAt": null,
        "customFieldValues": [
          {
            "name": "manufactureYear",
            "dataType": "NUMBER",
            "uiType": "INPUT",
            "value": 0
          },
          {
            "name": "certifications",
