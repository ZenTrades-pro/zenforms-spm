            "dataType": "TEXT",
            "uiType": "DROPDOWN",
            "value": ""
          },
          {
            "name": "notes",
            "dataType": "TEXT",
            "uiType": "TEXTAREA",
            "value": null
          }
        ]
      },
      "expected": {
        "ASSET": {},
        "ASSET_CUSTOM_FIELD": {
          "manufactureyear": "0"
        }
      },
      "lookups": [
        {
          "entityType": "ASSET",
          "entity": "serialNumber",
          "value": ""
        },
        {
          "entityType": "ASSET_CUSTOM_FIELD",
          "entity": "batteryType",
          "value": ""
        }
      ]
    },
    {
      "id": "checkbox-as-array",
      "description": "A checkbox value that arrives as an array is joined with \", \", skipping blank entries.",
      "asset": {
        "customFieldValues": [
          {
            "name": "certifications",
            "dataType": "ARRAY",
            "uiType": "CHECKBOX",
            "value": [
              "UL 268",
              "",
              "FM"
            ]
          }
        ]
      },
      "expected": {
        "ASSET": {},
        "ASSET_CUSTOM_FIELD": {
          "certifications": "UL 268, FM"
        }
      }
    },
    {
      "id": "value-without-name",
      "description": "A custom field value with no name (and no asset type to look it up in) gives no key.",
      "asset": {
        "customFieldValues": [
          {
            "assetCustomFieldId": 999,
            "value": "orphan"
          }
        ]
      },
      "expected": {
        "ASSET": {},
        "ASSET_CUSTOM_FIELD": {}
      }
    },
    {
      "id": "asset-type-fallback",
      "description": "Offline, or a backend without the new fields: names, types and assetTypeName come from the asset type, joined on assetCustomFieldId = customFields[].id. A value whose field was deleted from the type is dropped.",
      "asset": {
        "id": 301,
        "assetTypeId": 11,
        "name": "SD-01",
        "customFieldValues": [
          {
            "assetCustomFieldId": 901,
            "value": "2019"
          },
          {
            "assetCustomFieldId": 903,
            "value": 1748736000000
          },
          {
            "assetCustomFieldId": 777,
            "value": "from a deleted field"
          }
        ]
      },
      "assetType": {
        "id": 11,
        "name": "Smoke Detector",
        "customFields": [
          {
            "id": 901,
            "name": "manufactureYear",
            "displayName": "Manufacture Year",
            "dataType": "NUMBER",
            "uiType": "INPUT"
          },
          {
            "id": 903,
            "name": "lastBatteryChange",
            "displayName": "Last Battery Change",
            "dataType": "DATE",
            "uiType": "INPUT"
          }
        ]
      },
      "expected": {
        "ASSET": {
          "name": "SD-01",
          "assetTypeName": "Smoke Detector"
        },
        "ASSET_CUSTOM_FIELD": {
          "manufactureyear": "2019",
          "lastbatterychange": "06/01/2025"
        }
      }
    },
